# Copy this file to .env and set values for your local environment.
# Do not commit the real .env file.

APP_ENV=development
DEBUG=true

# Database for the FastAPI application
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_local_mysql_password
DB_NAME=auditdb

# Separate database used for authentication
AUTH_DB_NAME=credit_auth_db

# Database for raw SHAP values (chatbot retrieval)
RAW_SHAP_DB_NAME=raw_shap_values
# Optional chatbot-specific overrides; defaults fall back to DB_* above.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_local_mysql_password
MYSQL_DATABASE=raw_shap_values

KAFKA_BROKER=localhost:9092
FRONTEND_ORIGIN=http://localhost:5173
SQLALCHEMY_ECHO=false

# Optional: required only for the separate chatbot API
GROQ_API_KEY=your_groq_api_key_here
